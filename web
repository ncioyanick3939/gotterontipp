  useEffect(() => {
    const t = setInterval(() => setTick(Date.now()), 1000);
    return () => clearInterval(t);
  }, []);

  const showToast = (msg) => {
    setToast(msg);
    setTimeout(() => setToast(null), 2600);
  };

  const spent = useMemo(
    () => roster.reduce((s, id) => s + (PLAYERS.find((p) => p.id === id)?.price || 0), 0),
    [roster]
  );
  const FANTASY_BUDGET = 10000;

  /* Tipp abgeben */
  const placeBet = (gameId, team, amount) => {
    setTipBalance((b) => b - amount);
    setMyBets((m) => ({ ...m, [gameId]: { team, amount } }));
    setGames((gs) =>
      gs.map((g) =>
        g.id === gameId
          ? { ...g, groupBets: [...g.groupBets, { user: ME, team, amount }] }
          : g
      )
    );
    setTipModal(null);
    showToast(`Tipp abgegeben: ${fmt(amount)} auf ${TEAMS[team].short}`);
  };

  /* Fantasy add/remove */
  const toggleRoster = (id) => {
    const p = PLAYERS.find((x) => x.id === id);
    if (roster.includes(id)) {
      setRoster((r) => r.filter((x) => x !== id));
      return;
    }
    const posCount = roster.filter(
      (r) => PLAYERS.find((x) => x.id === r)?.pos === p.pos
    ).length;
