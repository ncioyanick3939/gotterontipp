function Stat({ l, v, accent, good }) {
  return (
    <div>
      <p className="text-[10px] uppercase tracking-widest text-slate-500">{l}</p>
      <p className={`text-lg font-bold tabular-nums ${accent ? "text-red-400" : good ? "text-emerald-400" : "text-white"}`}>{v}</p>
    </div>
