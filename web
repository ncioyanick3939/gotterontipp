          <div className="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 max-w-md w-[90%]">
            <div className="bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm text-center shadow-2xl shadow-black/60">
