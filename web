}

/* Eisfeld-Aufstellung (Signatur-Element) */
function IceRink({ byPos, onOpenPlayer }) {
  const dot = (p) => (
    <button key={p.id} onClick={() => onOpenPlayer(p.id)}
      className="flex flex-col items-center gap-1 focus:outline-none">
      <div className="h-11 w-11 rounded-full grid place-items-center text-xs font-bold shadow-lg"
        style={{ background: TEAMS[p.team].color, border: "2px solid rgba(255,255,255,.25)" }}>
        {p.num}
      </div>
      <span className="text-[10px] text-slate-200 leading-tight max-w-[60px] truncate">{p.last}</span>
    </button>
  );
  const empty = (k) => (
    <div key={k} className="flex flex-col items-center gap-1 opacity-40">
      <div className="h-11 w-11 rounded-full border-2 border-dashed border-slate-600 grid place-items-center">
        <Plus size={16} className="text-slate-600" />
      </div>
      <span className="text-[10px] text-slate-600">frei</span>
    </div>
  );
  const line = (pos, n) => {
    const ps = byPos(pos);
    return Array.from({ length: n }).map((_, i) => (ps[i] ? dot(ps[i]) : empty(`${pos}${i}`)));
  };
  return (
    <div className="rounded-2xl overflow-hidden border border-blue-900/40 relative"
      style={{ background: "linear-gradient(180deg,#0c1a33,#0a1120)" }}>
      {/* Eis-Linien */}
      <div className="absolute inset-x-0 top-1/2 h-px bg-red-500/40" />
      <div className="absolute inset-x-0 top-[30%] h-px bg-blue-400/25" />
      <div className="absolute inset-x-0 top-[70%] h-px bg-blue-400/25" />
      <div className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-16 w-16 rounded-full border border-blue-400/20" />
      <div className="relative py-5 space-y-5">
        <div className="flex justify-around px-6">{line("FORWARD", 3)}</div>
        <div className="flex justify-around px-10">{line("DEFENDER", 2)}</div>
        <div className="flex justify-center">{line("GOALIE", 1)}</div>
      </div>
    </div>
  );
}

function RosterSlot({ pos, players, onOpenPlayer, onToggle }) {
  const max = ROSTER_RULES[pos];
  return (
    <div className="rounded-2xl bg-slate-900 border border-slate-800 p-4">
      <div className="flex items-center justify-between mb-3">
        <span className="font-semibold flex items-center gap-2">
          {pos === "GOALIE" ? "🥅" : pos === "DEFENDER" ? "🛡️" : "🏒"} {POS_LABEL[pos]}
