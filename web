    ["fantasy", "🧠 Fantasy"],
    ["pop", "❤️ Beliebtheit"],
    ["streak", "🔥 Serie"],
  ];

  const tip = [...MEMBERS].sort((a, b) => b.tipPts - a.tipPts);
