          <PlayerModal
            player={PLAYERS.find((p) => p.id === playerModal)}
            isFav={favorite === playerModal}
            inRoster={roster.includes(playerModal)}
            onFav={() => { setFavorite(playerModal); showToast("Lieblingsspieler gesetzt"); }}
