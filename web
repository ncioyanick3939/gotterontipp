            <Dashboard
              tick={tick} games={games} myBets={myBets} tipBalance={tipBalance}
              spent={spent} budget={FANTASY_BUDGET}
              onTip={(id) => setTipModal(id)} onGoto={setTab}
            />
          )}
          {tab === "games" && (
            <GamesView tick={tick} games={games} myBets={myBets} onTip={(id) => setTipModal(id)} />
          )}
          {tab === "fantasy" && (
            <FantasyView
              roster={roster} spent={spent} budget={FANTASY_BUDGET}
              onToggle={toggleRoster} onOpenPlayer={(id) => setPlayerModal(id)}
            />
          )}
          {tab === "rank" && <RankingView roster={roster} favorite={favorite} />}
          {tab === "profile" && (
            <ProfileView
              tipBalance={tipBalance} favorite={favorite}
              onOpenPlayer={(id) => setPlayerModal(id)} myBets={myBets} games={games}
            />
