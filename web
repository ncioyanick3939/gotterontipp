            {l}
          </button>
        ))}
      </div>

      <div className="rounded-2xl bg-slate-900 border border-slate-800 divide-y divide-slate-800">
        {board === "tip" && tip.map((m, i) => <RankRow key={m.name} i={i} name={m.name} val={`${fmt(m.tipPts)} Pkt`} />)}
        {board === "fantasy" && fantasy.map((m, i) => <RankRow key={m.name} i={i} name={m.name} val={`${m.val} Fantasy-Pkt`} />)}
        {board === "pop" && pop.map((m, i) => <RankRow key={m.name} i={i} name={m.name} val={`Ø ${m.val} Beliebtheit`} />)}
        {board === "streak" && streak.map((m, i) => <RankRow key={m.name} i={i} name={m.name} val={`${m.streak} in Serie`} />)}
      </div>
    </div>
  );
}
function RankRow({ i, name, val }) {
  const medal = ["🥇", "🥈", "🥉"][i];
  return (
    <div className="flex items-center gap-3 px-4 py-3">
      <span className="w-7 text-center font-bold text-slate-400">{medal || i + 1}</span>
      <div className="h-8 w-8 rounded-full bg-slate-700 grid place-items-center text-sm font-bold flex-shrink-0">{name[0]}</div>
      <span className={`flex-1 ${name === ME ? "text-white font-semibold" : "text-slate-300"}`}>{name}{name === ME && " · du"}</span>
      <span className="tabular-nums text-sm text-slate-300">{val}</span>
    </div>
  );
}

