  const pop = MEMBERS.map((m, i) => ({ ...m, val: 68 + ((i * 53) % 28) })).sort((a, b) => b.val - a.val);

  return (
    <div className="px-4 pt-6 space-y-4">
      <h1 className="text-2xl font-bold tracking-tight">Rangliste</h1>
