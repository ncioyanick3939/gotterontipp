function TeamBadge({ team, size = "md", align = "left" }) {
  const dim = size === "lg" ? "h-12 w-12 text-2xl" : "h-10 w-10 text-xl";
  return (
    <div className={`flex items-center gap-2.5 ${align === "right" ? "flex-row-reverse text-right" : ""}`}>
      <div className={`${dim} rounded-xl grid place-items-center`} style={{ background: team.color + "22", border: `1px solid ${team.color}55` }}>
        <span>{team.tag}</span>
      </div>
      <div className={align === "right" ? "text-right" : ""}>
        <p className="font-bold leading-tight text-sm">{team.short}</p>
        <p className="text-[11px] text-slate-500 leading-tight">{team.name}</p>
      </div>
    </div>
