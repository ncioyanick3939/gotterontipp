function MiniStat({ icon, l, v }) {
  return (
    <div className="rounded-xl bg-slate-800/50 border border-slate-700 p-3">
      <div className="flex items-center gap-1.5 text-slate-400 text-[11px]">{icon}{l}</div>
      <p className="font-bold mt-0.5 tabular-nums">{v}</p>
    </div>
  );
}
