function GameCard({ game, tick, myBet, onTip }) {
  const lockAt = game.start - TIP_LOCK_MS;
  const remaining = lockAt - tick;
  const open = game.status === "OPEN" && remaining > 0;

  const pool = game.groupBets.reduce((s, b) => s + b.amount, 0);
  const homePool = game.groupBets.filter((b) => b.team === game.home).reduce((s, b) => s + b.amount, 0);
  const awayPool = pool - homePool;

  return (
    <div className="rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden">
      <div className="px-4 py-2 flex items-center justify-between border-b border-slate-800">
        <span className="text-[11px] text-slate-400">
          {new Date(game.start).toLocaleString("de-CH", { weekday: "short", hour: "2-digit", minute: "2-digit" })}
        </span>
        <StatusBadge status={open ? "OPEN" : game.status} />
      </div>

      <Matchup home={game.home} away={game.away} homeScore={game.homeScore} awayScore={game.awayScore} />

      {/* Pool */}
      {pool > 0 && (
        <div className="px-4 pb-3">
          <div className="flex justify-between text-[11px] text-slate-400 mb-1">
            <span>{TEAMS[game.home].short} {Math.round((homePool / pool) * 100)}%</span>
            <span>Pool {fmt(pool)}</span>
            <span>{Math.round((awayPool / pool) * 100)}% {TEAMS[game.away].short}</span>
          </div>
          <div className="h-2 rounded-full overflow-hidden flex bg-slate-800">
            <div style={{ width: `${(homePool / pool) * 100}%`, background: TEAMS[game.home].color }} />
            <div style={{ width: `${(awayPool / pool) * 100}%`, background: TEAMS[game.away].color }} />
          </div>
        </div>
      )}

      {/* Aktion */}
      <div className="px-4 pb-4">
        {game.status === "FINISHED" ? (
          <div className="rounded-xl bg-slate-800/60 border border-slate-700 p-3 text-sm flex items-center justify-between">
            <span className="text-slate-400">Endstand · Sieger {TEAMS[game.result].short}</span>
            {myBet && (
              <span className={myBet.won ? "text-emerald-400 font-semibold" : "text-red-400 font-semibold"}>
                {myBet.won ? `+${fmt(myBet.payout)}` : `−${fmt(myBet.amount)}`}
              </span>
            )}
          </div>
        ) : myBet ? (
          <div className="rounded-xl bg-slate-800/60 border border-slate-700 p-3 text-sm flex items-center justify-between">
            <span className="text-slate-400">Dein Tipp</span>
            <span className="font-semibold">{TEAMS[myBet.team].tag} {TEAMS[myBet.team].short} · {fmt(myBet.amount)}</span>
          </div>
        ) : open ? (
          <button
            onClick={() => onTip(game.id)}
            className="w-full bg-red-600 hover:bg-red-500 active:scale-[0.99] transition rounded-xl py-2.5 font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            Tippen · schliesst in {fmtCountdown(remaining)}
          </button>
        ) : (
          <div className="rounded-xl bg-slate-800/40 border border-slate-800 p-2.5 text-center text-sm text-slate-500 flex items-center justify-center gap-1.5">
            <Lock size={14} /> Tipps geschlossen
          </div>
        )}
      </div>

      {/* Gruppen-Tipps */}
      {game.groupBets.length > 0 && (
        <div className="px-4 pb-4">
          <p className="text-[11px] uppercase tracking-widest text-slate-500 mb-2">Tipps der Gruppe</p>
          <div className="space-y-1.5">
            {game.groupBets.map((b, i) => (
              <div key={i} className="flex items-center justify-between text-sm">
                <span className={b.user === ME ? "text-white font-medium" : "text-slate-300"}>{b.user}</span>
                <span className="flex items-center gap-2 text-slate-300">
                  <span>{TEAMS[b.team].tag} {TEAMS[b.team].short}</span>
                  <span className="tabular-nums text-slate-400">{fmt(b.amount)}</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

/* Matchup-Anzeige (Scoreboard-Stil) */
function Matchup({ home, away, homeScore, awayScore, big }) {
