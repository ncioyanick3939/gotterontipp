      </span>
      <span className={`text-sm font-semibold tabular-nums ${up ? "text-emerald-400" : "text-red-400"}`}>
        {up ? "+" : ""}{p.trend}%
      </span>
    </button>
  );
}
function PopDot({ v }) {
  const c = v >= 80 ? "#10b981" : v >= 60 ? "#3b82f6" : v >= 40 ? "#eab308" : "#ef4444";
  return <span className="h-2 w-2 rounded-full inline-block" style={{ background: c }} />;
}

