}

function StatusBadge({ status }) {
  const map = {
    OPEN: { t: "Offen", c: "bg-emerald-500/15 text-emerald-400 border-emerald-500/30" },
    LOCKED: { t: "Geschlossen", c: "bg-slate-500/15 text-slate-400 border-slate-500/30" },
    LIVE: { t: "Live", c: "bg-red-500/15 text-red-400 border-red-500/30" },
    FINISHED: { t: "Beendet", c: "bg-slate-500/15 text-slate-400 border-slate-500/30" },
    UPCOMING: { t: "Bald", c: "bg-blue-500/15 text-blue-400 border-blue-500/30" },
  };
  const s = map[status] || map.UPCOMING;
  return (
    <span className={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border ${s.c} flex items-center gap-1`}>
      {status === "LIVE" && <Circle size={7} className="fill-red-500 text-red-500 animate-pulse" />}
      {s.t}
    </span>
  );
}

/* ================================================================== */
/*  Tipp-Modal                                                         */
/* ================================================================== */
function TipModal({ game, balance, tick, existing, onClose, onConfirm }) {
  const [team, setTeam] = useState(null);
  const [amount, setAmount] = useState(0);
  const [custom, setCustom] = useState("");
  const [confirming, setConfirming] = useState(false);

  const lockAt = game.start - TIP_LOCK_MS;
  const remaining = lockAt - tick;
  const locked = remaining <= 0;

  const quick = [10, 25, 50, 100, 250, 500];
  const valid = team && amount > 0 && amount <= balance && !locked;

  return (
    <div className="fixed inset-0 z-50 flex items-end justify-center">
      <div className="absolute inset-0 bg-black/70" onClick={onClose} />
      <div className="relative w-full max-w-md bg-slate-900 border-t border-slate-700 rounded-t-3xl p-5 pb-8" style={{ animation: "slideup .2s ease" }}>
        <div className="w-10 h-1 bg-slate-700 rounded-full mx-auto mb-4" />

        <div className="flex items-center justify-between mb-4">
          <h2 className="font-bold text-lg">Wer gewinnt?</h2>
          <button onClick={onClose} className="text-slate-500 p-1"><X size={20} /></button>
        </div>

        {locked && (
          <div className="mb-4 rounded-xl bg-red-500/10 border border-red-500/30 p-3 text-sm text-red-300 flex items-center gap-2">
            <Lock size={16} /> Tippfrist abgelaufen (60-Min-Regel).
          </div>
        )}

        {/* Teamwahl */}
        <div className="grid grid-cols-2 gap-3 mb-5">
          {[game.home, game.away].map((t) => {
            const T = TEAMS[t];
            const sel = team === t;
            return (
              <button
                key={t}
                disabled={locked}
                onClick={() => setTeam(t)}
                className={`rounded-2xl p-4 border-2 transition text-center disabled:opacity-40 ${
                  sel ? "border-red-500 bg-red-500/10" : "border-slate-700 bg-slate-800/40"
                }`}
              >
                <div className="text-2xl mb-1">{T.tag}</div>
                <div className="font-bold text-sm">{T.short}</div>
                <div className="text-[11px] text-slate-500">{T.name}</div>
              </button>
            );
          })}
        </div>

        {/* Einsatz */}
        <p className="text-xs uppercase tracking-widest text-slate-500 mb-2">Einsatz</p>
        <div className="grid grid-cols-3 gap-2 mb-3">
          {quick.map((q) => (
            <button
              key={q}
              disabled={locked || q > balance}
              onClick={() => { setAmount(q); setCustom(""); }}
              className={`rounded-xl py-2.5 font-semibold text-sm border transition disabled:opacity-30 ${
                amount === q && !custom ? "border-red-500 bg-red-500/10 text-white" : "border-slate-700 bg-slate-800/40 text-slate-300"
              }`}
            >
              {q}
            </button>
          ))}
        </div>
        <input
          type="number" inputMode="numeric" placeholder="Eigener Betrag"
          value={custom} disabled={locked}
          onChange={(e) => {
            setCustom(e.target.value);
            setAmount(Math.max(0, parseInt(e.target.value || "0", 10)));
          }}
          className="w-full rounded-xl bg-slate-800 border border-slate-700 px-4 py-3 mb-4 text-white placeholder:text-slate-500 focus:outline-none focus:border-red-500"
        />

        {/* Guthaben-Rechnung */}
        <div className="rounded-xl bg-slate-800/50 border border-slate-700 p-3 mb-5 text-sm space-y-1">
          <Row l="Aktuelles Guthaben" v={fmt(balance)} />
          <Row l="Einsatz" v={amount ? fmt(amount) : "0"} accent />
          <div className="border-t border-slate-700 my-1" />
          <Row l="Verbleibend" v={fmt(Math.max(0, balance - amount))} bold />
        </div>

        {/* Bestätigen */}
        {!confirming ? (
          <button
            disabled={!valid}
            onClick={() => setConfirming(true)}
            className="w-full bg-red-600 hover:bg-red-500 disabled:bg-slate-700 disabled:text-slate-500 rounded-xl py-3.5 font-bold tracking-wide transition"
          >
            TIPP ABGEBEN
          </button>
        ) : (
          <div className="space-y-3">
            <p className="text-center text-sm text-slate-300">
              Du setzt <b className="text-white">{fmt(amount)}</b> Punkte auf <b className="text-white">{TEAMS[team].name}</b>.
            </p>
            <div className="grid grid-cols-2 gap-3">
              <button onClick={() => setConfirming(false)} className="rounded-xl py-3 border border-slate-700 font-semibold text-slate-300">
                Abbrechen
              </button>
              <button onClick={() => onConfirm(game.id, team, amount)} className="rounded-xl py-3 bg-emerald-600 hover:bg-emerald-500 font-semibold flex items-center justify-center gap-2">
                <Check size={18} /> Bestätigen
              </button>
            </div>
          </div>
        )}
      </div>
      <style>{`@keyframes slideup{from{transform:translateY(100%)}to{transform:translateY(0)}}`}</style>
    </div>
  );
}
function Row({ l, v, accent, bold }) {
  return (
    <div className="flex justify-between">
      <span className="text-slate-400">{l}</span>
      <span className={`tabular-nums ${accent ? "text-red-400" : ""} ${bold ? "font-bold text-white" : "text-slate-200"}`}>{v}</span>
    </div>
  );
}

