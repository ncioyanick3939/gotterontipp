/* ---- Konfiguration Preisformel (deterministisch, monoton) --------- */
const PRICE_CONFIG = { base: 300, range: 1700, exponent: 1.3, roundTo: 50 };
function priceFromPopularity(score) {
  const { base, range, exponent, roundTo } = PRICE_CONFIG;
  const raw = base + Math.pow(score / 100, exponent) * range;
  return Math.round(raw / roundTo) * roundTo;
}

