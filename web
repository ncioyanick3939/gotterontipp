      </div>

      {/* Budget-Leiste */}
      <div className="rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 p-4">
        <div className="grid grid-cols-3 text-center">
          <Stat l="Budget" v={fmt(budget)} />
          <Stat l="Ausgegeben" v={fmt(spent)} />
