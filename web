        <button onClick={onClose} className="absolute top-4 right-4 text-slate-500"><X size={20} /></button>

        <div className="flex items-center gap-4 mb-5">
          <div className="h-16 w-16 rounded-2xl grid place-items-center text-2xl font-extrabold" style={{ background: T.color }}>
            {p.num}
          </div>
          <div>
            <h2 className="text-xl font-bold">{p.name}</h2>
            <p className="text-slate-400 text-sm">{T.name} · {POS_LABEL[p.pos]}</p>
          </div>
        </div>

        {/* Popularity gross */}
        <div className="rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 p-4 mb-3">
          <div className="flex items-end justify-between">
            <div>
              <p className="text-[11px] uppercase tracking-widest text-slate-500">Popularity Score</p>
              <p className="text-4xl font-extrabold tabular-nums">{p.pop}<span className="text-lg text-slate-500">/100</span></p>
            </div>
            <div className="text-right">
              <p className="text-[11px] uppercase tracking-widest text-slate-500">Fantasy-Preis</p>
              <p className="text-2xl font-bold tabular-nums text-red-400">{fmt(p.price)}</p>
            </div>
          </div>
          <div className="h-2 rounded-full bg-slate-800 mt-3 overflow-hidden">
            <div className="h-full" style={{ width: `${p.pop}%`, background: p.pop >= 80 ? "#10b981" : p.pop >= 60 ? "#3b82f6" : p.pop >= 40 ? "#eab308" : "#ef4444" }} />
          </div>
        </div>

        <div className="grid grid-cols-2 gap-3 mb-5 text-sm">
          <MiniStat icon={<TrendingUp size={15} className={p.trend >= 0 ? "text-emerald-400" : "text-red-400"} />} l="Diese Woche" v={`${p.trend >= 0 ? "+" : ""}${p.trend}%`} />
          <MiniStat icon={<Users size={15} className="text-blue-400" />} l="Fantasy-Teams" v={p.teamsCount} />
          <MiniStat icon={<Heart size={15} className="text-red-400" />} l="Lieblingsspieler" v={`${p.favCount} Mitgl.`} />
          <MiniStat icon={<Trophy size={15} className="text-yellow-400" />} l="Spieler des Spiels" v={`${p.potg}×`} />
        </div>

        <div className="grid grid-cols-2 gap-3">
          <button onClick={onFav}
            className={`rounded-xl py-3 font-semibold flex items-center justify-center gap-2 border ${isFav ? "bg-red-600 border-red-600" : "border-slate-700 text-slate-300"}`}>
            <Heart size={18} className={isFav ? "fill-white" : ""} /> {isFav ? "Liebling" : "Als Liebling"}
          </button>
          <button onClick={onToggle}
            className={`rounded-xl py-3 font-semibold flex items-center justify-center gap-2 ${inRoster ? "bg-slate-700" : "bg-emerald-600"}`}>
